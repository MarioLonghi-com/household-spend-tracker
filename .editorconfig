# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

# A trailing double space is a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Statement fixtures are byte-for-byte copies of a bank's shape; leave them be.
[tests/statement_files/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
