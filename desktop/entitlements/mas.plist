<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Mac App Store app's entitlements (#59, #61). @TEAM_ID@ and @BUNDLE_ID@
  are filled in by scripts/sign-mas.sh from the signing identity's team, so
  no account's id is written into the repository.

  - app-sandbox: required for the store.
  - the application group, prefixed with the team: without it Electron's
    Mach port check crashes the app at launch in the sandbox.
  - network.client: the YNAB import and the release check, both started by
    the person. Nothing listens: there is no network.server.
  - files.user-selected and bookmarks.app-scope: the backups folder the person
    chooses, kept across launches.
  - cs.allow-jit: V8.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.application-identifier</key><string>@TEAM_ID@.@BUNDLE_ID@</string>
  <key>com.apple.developer.team-identifier</key><string>@TEAM_ID@</string>
  <key>com.apple.security.application-groups</key><array><string>@TEAM_ID@.@BUNDLE_ID@</string></array>
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.files.user-selected.read-write</key><true/>
  <key>com.apple.security.files.bookmarks.app-scope</key><true/>
  <key>com.apple.security.cs.allow-jit</key><true/>
</dict>
</plist>
