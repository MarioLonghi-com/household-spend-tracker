# cp .env.example .env && chmod 600 .env
#
# Admin console -> Settings -> Keys -> Generate auth key:
#   Reusable: yes.  Ephemeral: no.  Tags: tag:spend-tracker.
# The tag must exist in the policy file first (tagOwners), or the key cannot
# be minted with it. Tagged nodes never expire, so this key is used once per
# fresh ts-state volume and then only kept so the file can be rebuilt.
TS_AUTHKEY=tskey-auth-REPLACE-ME

# Where people reach it, as an origin. The node is named `spend-tracker`.
SPENDTRACKER_PUBLIC_URL=https://spend-tracker.REPLACE-ME.ts.net

# The tag the image is built as, from a checkout of that version.
SPENDTRACKER_VERSION=0.5.1
