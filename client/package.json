{
  "name": "household-spend-tracker-client",
  "private": true,
  "version": "0.9.1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "extract": "lingui extract --clean --workers 1",
    "e2e": "npm run build && playwright test",
    "e2e:ui": "npm run build && playwright test --ui"
  },
  "dependencies": {
    "@lingui/core": "6.8.0",
    "@lingui/react": "6.8.0",
    "@tanstack/react-query": "^5.104.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@lingui/babel-plugin-lingui-macro": "6.8.0",
    "@lingui/cli": "6.8.0",
    "@lingui/conf": "6.8.0",
    "@lingui/format-po": "6.8.0",
    "@lingui/message-utils": "6.8.0",
    "@lingui/vite-plugin": "6.8.0",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "micromatch": "file:vendor/micromatch",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "micromatch": "$micromatch"
  }
}
